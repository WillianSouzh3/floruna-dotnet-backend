<Project>
  <!--
    Configuração comum a TODOS os projetos da solution.
    Mudar aqui vale para src/ e tests/ — evita csproj divergentes.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Qualidade: aviso é erro; analisadores do SDK ligados; estilo do .editorconfig valida no build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- XML docs alimentam o OpenAPI; CS1591 (membro público sem doc) seria ruído. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1573: documentar só os parâmetros não óbvios é intencional. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <!-- Central Package Management: versões só em Directory.Packages.props. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Nomes de teste com underscore (Metodo_condicao_resultado) são convenção. -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>
</Project>
